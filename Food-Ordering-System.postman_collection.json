					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"",
									"if (response.access_token) {",
									"    pm.environment.set(\"access_token\", response.access_token);",
									"    console.log(\"Token saved to environment\");",
									"} else {",
									"    console.log(\"No access_token found in response\");",
									"}"
								],
